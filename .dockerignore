# ==============================================================================
# PlantDiseaseAI — .dockerignore
# Excludes local environments, datasets, cache, and raw files from container builds
# ==============================================================================

# Virtual environments
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node.js
frontend/node_modules/
frontend/.vite/

# Datasets (never bundle 50k+ raw training images into production container)
ml/data/raw/
ml/data/interim/
ml/data/processed/
ml/data/metadata/*_manifest.csv

# Git & IDE
.git/
.gitignore
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs & temp files
*.log
backend/runtime/plantdiseaseai.db
backend/runtime/*.jpg
backend/runtime/*.png
backend/runtime/*.webp
