# PlantDiseaseAI Frontend Environment Configuration
# Copy this file to .env and adjust for your local Phase 7 FastAPI backend.

# Base URL of the PlantDiseaseAI FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8001

# Request timeout in milliseconds (default: 30000 for inference, 15000 for standard requests)
VITE_API_TIMEOUT_MS=30000
