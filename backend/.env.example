# ==============================================================================
# PlantDiseaseAI — FastAPI Backend Environment Configuration Example
# Copy to backend/.env and customize for your local environment.
# NEVER commit real secrets or production credentials to Git.
# ==============================================================================

# Application metadata
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# CORS (comma-separated explicit origins; never use '*' in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Model & Phase 2/3 ML configuration paths (relative to PlantDiseaseAI root)
MODEL_CHECKPOINT_PATH=ml/experiments/checkpoints/exp_a_agrivision_cnn/best_model.pth
MODEL_CONFIG_PATH=ml/configs/model_config.yaml
DATASET_CONFIG_PATH=ml/configs/dataset_config.yaml
CLASS_MAPPING_PATH=ml/configs/class_mapping.yaml

# Inference device: auto | cuda | cpu
INFERENCE_DEVICE=auto

# Uncertainty / rejection policy thresholds
CONFIDENCE_THRESHOLD=0.60
ENTROPY_THRESHOLD=1.60
MIN_MARGIN_THRESHOLD=0.10
TOP_K_PREDICTIONS=3

# Upload security & retention
MAX_UPLOAD_SIZE_BYTES=10485760
RETAIN_UPLOADED_IMAGES=false
RESULTS_DIR=backend/runtime/results
TEMP_UPLOAD_DIR=backend/runtime/tmp

# Database (SQLite default; replaceable with PostgreSQL URL in future)
DATABASE_URL=sqlite:///backend/runtime/plantdiseaseai.db

# Basic in-memory rate limiting (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60
